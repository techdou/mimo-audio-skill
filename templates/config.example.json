{
  "api_key_env": "MIMO_API_KEY",
  "base_url_env": "MIMO_BASE_URL",
  "default_base_url": "https://api.xiaomimimo.com/v1",
  "auth_mode": "api-key",
  "default_model": "mimo-v2.5-tts",
  "default_voice": "冰糖",
  "default_format": "wav",
  "default_output_dir": "output/audio",
  "default_manifest": "output/audio_manifest.json",
  "default_raw_response_dir": "output/raw_responses",
  "default_style_instruction": "用温柔、清晰、适合课程讲解的语气朗读，语速中等偏慢，声音自然亲切。遇到重要概念时适当停顿，遇到步骤、定义、对比和案例时保持清楚的节奏感。不要像新闻播音，也不要过度情绪化。",
  "default_asr_model": "mimo-v2.5-asr",
  "default_asr_language": "auto",
  "default_asr_output_dir": "output/asr",
  "default_asr_manifest": "output/asr_manifest.json",
  "default_asr_raw_response_dir": "output/asr_raw_responses",
  "timeout": 120,
  "retries": 2,
  "sleep_between": 0.5,
  "min_chars": 20,
  "max_chars": 1000,
  "default_pipeline_output_dir": "output/course_audio",
  "default_player_title": "MiMo 讲义音频播放页",
  "default_subtitle_gap_seconds": 0.35,
  "default_merge_silence_ms": 350,
  "postprocess_concurrency": 4,
  "jsonl_log": "output/pipeline.jsonl",
  "doc_check_enabled": true,
  "doc_check_ttl_hours": 24,
  "doc_check_cache_dir": "output/.doc_cache",
  "known_rules_path": "templates/known_rules.json",
  "official_doc_urls": {
    "llms_txt": "https://mimo.mi.com/llms.txt",
    "tts": "https://mimo.mi.com/docs/zh-CN/quick-start/usage-guide/audio/speech-synthesis-v2.5",
    "asr": "https://mimo.mi.com/docs/zh-CN/quick-start/usage-guide/audio/Speech-Recognition"
  }
}
